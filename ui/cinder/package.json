{
  "name": "@game-library/cinder",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.css.ts"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts*\" --ignore-pattern \"**/*.stories.*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --ignore-pattern \"**/*.stories.*\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@game-library/armature": "workspace:*",
    "@game-library/icon": "workspace:*",
    "@game-library/tokens": "workspace:*",
    "@game-library/types": "workspace:*",
    "@vanilla-extract/css": "^1.20.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.9.0",
    "recharts": "2.15.4",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@game-library/eslint-config": "workspace:*",
    "@game-library/typescript-config": "workspace:*",
    "@turbo/gen": "^2.9.3",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "eslint": "^8.57.1",
    "tsup": "^8.5.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components/base/*": {
      "types": "./dist/index.d.ts",
      "import": "./dist/components/base/*/index.js",
      "require": "./dist/components/base/*/index.cjs"
    },
    "./components/blocks/*": {
      "types": "./dist/index.d.ts",
      "import": "./dist/components/blocks/*/index.js",
      "require": "./dist/components/blocks/*/index.cjs"
    },
    "./providers/UISystemProvider": {
      "types": "./dist/index.d.ts",
      "import": "./dist/providers/UISystemProvider.js",
      "require": "./dist/providers/UISystemProvider.cjs"
    },
    "./theme": {
      "types": "./dist/index.d.ts",
      "import": "./dist/themes/runtime.js",
      "require": "./dist/themes/runtime.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./themes": "./src/themes/index.ts",
    "./themes/*": "./src/themes/*.css.ts",
    "./themes/globals.css": "./src/themes/globals.css.ts",
    "./themes/tokens": "./src/themes/tokens.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
