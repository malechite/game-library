# ─── Core ───────────────────────────────────────────────────────────────────
# Postgres connection string (overrides config/default.json).
GAME_LIBRARY_DB_URL=postgres://game_library:development@localhost:5432/game_library_db
# JWT signing secret — change this in any non-local environment.
FEATHERS_SECRET=change-me-in-production
# PORT=3030
# HOSTNAME=localhost
# Allowed browser origins as a JSON array (only needed when the SPA is served from another origin, e.g. Vite dev).
# ORIGINS=["http://localhost:5173"]

# ─── Object storage (MinIO / S3) for the asset service ──────────────────────
# The asset service uploads files via the S3 API (@aws-sdk/client-s3, path-style).
# These defaults match the `minio` service in docker-compose.yml — the access
# key/secret are MinIO's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. The bucket is
# auto-created (public-read) on startup for local dev. MinIO console: :9001.

# Base URL of the S3-compatible API (MinIO API port). In Docker use http://minio:9000.
S3_ENDPOINT=http://localhost:9000
# Browser-facing base URL for stored objects (defaults to S3_ENDPOINT when unset).
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Region — arbitrary for MinIO, but the SDK needs one for request signing.
S3_REGION=us-east-1
# Bucket where uploaded assets are stored.
S3_BUCKET=game-library
# Access key (MinIO root user).
S3_ACCESS_KEY_ID=game_library
# Secret key (MinIO root password) — change this in any non-local environment.
S3_SECRET_ACCESS_KEY=development

# ─── Cover art + game search ────────────────────────────────────────────────
# Box art is fetched in the background and stored in object storage. libretro
# thumbnails need no key and cover most retro platforms. Set to false to disable.
# COVERS_ENABLED=true

# IGDB (https://api-docs.igdb.com) powers the "Add game" search and covers for
# platforms libretro lacks (PS3/PS4/PS5/Switch/Vita). Create a Twitch application
# at https://dev.twitch.tv/console/apps and paste its credentials here. Optional:
# without them, search is limited to the local catalog.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
