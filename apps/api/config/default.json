{
  "host": "localhost",
  "port": 3030,
  "public": "../web/dist/",
  "origins": ["http://localhost:5173"],
  "paginate": {
    "default": 10,
    "max": 50
  },
  "postgresql": {
    "client": "pg",
    "connection": "postgres://game_library:development@localhost:5432/game_library_db"
  },
  "s3": {
    "endpoint": "http://localhost:9000",
    "region": "us-east-1",
    "bucket": "game-library",
    "accessKeyId": "game_library",
    "secretAccessKey": "development"
  },
  "covers": {
    "enabled": true,
    "concurrency": 3
  },
  "igdb": {
    "clientId": "",
    "clientSecret": ""
  },
  "authentication": {
    "entity": "user",
    "service": "users",
    "secret": "CHANGE_ME_IN_PRODUCTION",
    "authStrategies": ["jwt", "local"],
    "jwtOptions": {
      "header": { "typ": "access" },
      "audience": "https://game-library.everhart.io",
      "issuer": "game-library",
      "algorithm": "HS256",
      "expiresIn": "1d"
    },
    "local": {
      "usernameField": "email",
      "passwordField": "password"
    }
  }
}
