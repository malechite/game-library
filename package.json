{
  "name": "game-library",
  "author": {
    "name": "Brandon Everhart",
    "email": "malechite@gmail.com"
  },
  "version": "0.0.1",
  "description": "Game Library monorepo — Feathers API serving a Vite React SPA, built on in-repo design-system packages",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "predev": "docker compose up -d --wait postgres minio",
    "dev": "turbo dev --filter=!@game-library/storybook",
    "dev:storybook": "turbo dev",
    "start": "turbo start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo lint",
    "lint:fix": "prettier --write . && turbo lint -- --fix",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "db:setup": "pnpm --filter @game-library/api db:setup",
    "import:collection": "pnpm --filter @game-library/api import:collection",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "pnpm --filter @game-library/api test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@game-library/cinder": "workspace:*",
    "@game-library/eslint-config": "workspace:*",
    "@game-library/types": "workspace:*",
    "@game-library/typescript-config": "workspace:*",
    "@game-library/util": "workspace:*",
    "@storybook/addon-vitest": "^10.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vanilla-extract/recipes": "^0.5.5",
    "@vanilla-extract/vite-plugin": "^5.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "tsup": "^8.0.1",
    "turbo": "^2.9.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
